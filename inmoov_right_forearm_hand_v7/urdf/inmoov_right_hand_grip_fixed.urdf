  <joint name="base_to_forearm_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="r_forearm_link"/>
  </joint>
  <!--
       Two-DOF wrist:
       1) r_wrist_flexion_joint = wrist flexion/extension
          axis X, approximately +/- 60 degrees.
       2) r_wrist_rotation_joint = axial wrist/forearm rotation
          axis Z, retained from the original hand model.

       Both joints share the physical wrist origin.  The intermediate
       r_wrist_link carries no visual mesh; it only separates the two
       rotational degrees of freedom.
  -->
  <link name="r_wrist_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/>
    </inertial>
  </link>

  <!-- Wrist flexion / extension -->
  <joint name="r_wrist_flexion_joint" type="revolute">
    <!-- Human-like wrist flexion/extension: pitch about the palm-width Y axis -->
    <axis xyz="0 1 0"/>
    <limit effort="1000.0" lower="-1.0471975512" upper="1.0471975512" velocity="1.0"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="r_forearm_link"/>
    <child link="r_wrist_link"/>
  </joint>

  <!-- Axial wrist / forearm rotation -->
  <joint name="r_wrist_rotation_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="-1.0471975512" upper="1.0471975512" velocity="0.5"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="r_wrist_link"/>
    <child link="r_hand_link"/>
  </joint>
</robot>